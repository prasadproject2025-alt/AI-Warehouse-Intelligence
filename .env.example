# VisionGuard Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/visionguard.db

# Storage Directories
RAW_VIDEOS_DIR=./data/raw
PROCESSED_VIDEOS_DIR=./data/processed
EVIDENCE_DIR=./data/evidence

# Computer Vision Settings
YOLO_MODEL_PATH=yolov8n.pt
TRACKER_TYPE=bytetrack
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# AI Warehouse Assistant (Optional: provide Gemini API key for dynamic conversational reasoning)
GEMINI_API_KEY=
