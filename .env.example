# VisionGuard configuration — copy to .env and adjust.
# .env is git-ignored; never commit real credentials.

# ---------------------------------------------------------------- server
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated allowed browser origins. Use explicit origins in production;
# "*" disables credentialed CORS (browsers reject wildcard + credentials).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --------------------------------------------------------------- storage
DATABASE_URL=sqlite:///./data/visionguard.db
RAW_VIDEOS_DIR=./data/raw
PROCESSED_VIDEOS_DIR=./data/processed
EVIDENCE_DIR=./data/evidence
CLIPS_DIR=./data/clips

MAX_UPLOAD_MB=512
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm

# ------------------------------------------------------------- perception
# Open-vocabulary detection is what makes cartons/pallets/trolleys detectable
# at all — COCO has no such classes. Requires yolov8s-worldv2.pt plus the CLIP
# text encoder; the system falls back to COCO YOLOv8 automatically if absent.
USE_OPEN_VOCAB=true
OPEN_VOCAB_MODEL_PATH=yolov8s-worldv2.pt
YOLO_MODEL_PATH=yolov8n.pt

# Per-class thresholds: products score lower than people under an
# open-vocabulary head, so they need a lower gate.
PERSON_CONF=0.25
PRODUCT_CONF=0.12
EQUIPMENT_CONF=0.20
IOU_THRESHOLD=0.45
INFERENCE_IMGSZ=640

# Throughput controls. Stride 3 analyses every third frame (~10 Hz at 30 fps).
DETECTION_FRAME_STRIDE=3
MAX_INFERENCE_WIDTH=960

# --------------------------------------------------------- behaviour engine
ALERT_COOLDOWN_SEC=4.0
MIN_TRACK_AGE_SEC=0.35

# ------------------------------------------------------------- evidence
GENERATE_EVIDENCE_CLIPS=true
EVIDENCE_CLIP_PRE_SEC=2.0
EVIDENCE_CLIP_POST_SEC=2.0

# --------------------------------------------------------- responsible AI
# Faces are blurred in stored evidence by default. Disable only for a pilot
# where operators have been informed and consented to identifiable review.
BLUR_FACES_IN_EVIDENCE=true
EVIDENCE_RETENTION_DAYS=30

# ------------------------------------------------- optional LLM rephrasing
# The assistant is retrieval-grounded and fully functional without any LLM.
# If a key is supplied AND polishing is enabled, an LLM may only reword the
# already-retrieved answer — it is never the source of facts.
ASSISTANT_LLM_POLISH=false
GEMINI_API_KEY=
